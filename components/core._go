package components

import (
	"strings"

	. "maragu.dev/gomponents"
	. "maragu.dev/gomponents/html"
)

type RenderTime struct {
	Child func() Native
}

func AtRenderTime(child func() Native) RenderTime  { return RenderTime{Child: child} }
func (c RenderTime) Render(ctx RenderContext) Node { return c.Child().Render(ctx) }
func (c RenderTime) Measure(constraint Size) Size {
	return c.Child().Measure(ctx, constraint)
}

func (c RenderTime) Layout(rect Rect) LayoutNode {
	return c.Child().Layout(ctx, rect)
}
